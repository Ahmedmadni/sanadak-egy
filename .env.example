# Public Supabase configuration.
# Copy to .env locally and fill values from the deployment environment.
# Never commit service-role keys or other privileged secrets.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=


# Merchant onboarding: public payment recipient information only.
# Paid registration stays PAUSED until these settings are filled and
# independently verified by the business operator. These VITE_ values
# are shipped to every visitor's browser: NEVER put secrets or API keys here.
#
# 1. Confirm recipient identity and account/phone ownership outside the app.
# 2. Set this to true only after verification and staging tests.
# 3. Set up one or both channels with complete values.
# 4. No account details are provided by default.
VITE_SANADAK_PAYMENT_DETAILS_VERIFIED=false
VITE_SANADAK_VODAFONE_CASH_NUMBER=
VITE_SANADAK_BANK_NAME_AR=
VITE_SANADAK_BANK_NAME_EN=
VITE_SANADAK_BANK_BENEFICIARY_AR=
VITE_SANADAK_BANK_BENEFICIARY_EN=
VITE_SANADAK_BANK_ACCOUNT_NUMBER=
